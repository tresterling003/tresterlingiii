{
  "name": "fieldview",
  "version": "1.0.0",
  "private": true,
  "description": "FIELDVIEW — 3D football recognition training simulator for projector walls",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
