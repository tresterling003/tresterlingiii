{
  "name": "createspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "CreateSpace \u2014 an all-in-one toolbox for creative professionals. Make space for creativity.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-cloud.mjs",
    "build:embedded": "tsc --noEmit && vite build --mode embedded --base ./ --outDir dist-embedded --emptyOutDir"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
