# Postgres connection strings from Neon (or any Postgres host).
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL: direct (unpooled) connection, used only for running migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=""

# Long random string that IS the family's access link:
#   yoursite.vercel.app/g/<FAMILY_ACCESS_SLUG>
# Generate with: openssl rand -hex 16
FAMILY_ACCESS_SLUG=""

# Used once by `npm run db:seed` to create the single admin login.
# Safe to remove from your env after the first successful seed.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Auto-populated by Vercel when you attach Blob storage to the project.
BLOB_READ_WRITE_TOKEN=""
