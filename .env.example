# Postgres connection strings from Neon (or any Postgres host).
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL: direct (unpooled) connection, used only for running migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign your session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=""

# Used once by `npm run db:seed` to create your login.
# Safe to remove from your env after the first successful seed.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Auto-populated by Vercel when you attach Blob storage to the project.
# Used to store photos of graded student work.
BLOB_READ_WRITE_TOKEN=""

# From console.anthropic.com — powers lesson/resource generation, the notes
# import, and photo-based grading. Needs billing enabled on the account.
ANTHROPIC_API_KEY=""

# Optional — defaults to claude-opus-5 (best quality). Set to claude-sonnet-5
# or claude-haiku-4-5 to cut cost if you're generating/grading at high volume.
ANTHROPIC_MODEL=""
