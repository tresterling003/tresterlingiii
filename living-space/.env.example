# ─── Living Space configuration ───────────────────────────────────────────────
# Copy to .env.local and fill in. Everything here is read on the server only;
# none of these values are ever sent to the browser.

# Public base URL of the app (used to build the OAuth redirect URI).
APP_URL=http://localhost:3000

# 32+ random characters. Encrypts the session cookie that holds your Google tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application).
# Authorised redirect URI:  ${APP_URL}/api/auth/google/callback
# Enable "Gmail API" and "Google Calendar API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: also request gmail.modify so the inbox can offer an explicit "Mark as read" button.
# Leave false to stay read-only (gmail.readonly).
GOOGLE_ALLOW_MARK_READ=false

# Optional: lock the app to one Google account. Sign-ins from any other address are rejected.
APP_OWNER_EMAIL=

# Phone alerts ingest (Apple Shortcuts, IFTTT, home automations…).
# 24+ random characters. Senders POST to /api/alerts with  Authorization: Bearer <token>.
ALERTS_INGEST_TOKEN=

# Where server-side alert data is stored when self-hosting (JSON file store). Must be writable.
DATA_DIR=./data
# On Vercel/serverless use Redis instead (Vercel → Storage → Upstash sets KV_REST_API_URL/TOKEN for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Show the demo/testing control panel in production builds (always on in `npm run dev`).
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
