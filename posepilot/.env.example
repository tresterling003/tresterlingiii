# Copy to .env and fill in ONE provider key to turn on AI drawing generation.
# Keys stay on the server; they are never sent to students' browsers.

# AI_PROVIDER=openai          # openai | gemini | none  (default: auto-detect from which key is set)
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium # low | medium | high (cost rises with quality)
# OPENAI_INPUT_FIDELITY=high  # high keeps the character closer to the original; set empty to omit

# GEMINI_API_KEY=...
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# POSEPILOT_MAX_PER_HOUR=60   # per-computer generation limit (0 = unlimited)
# POSEPILOT_TIMEOUT_MS=120000
# PORT=8787
