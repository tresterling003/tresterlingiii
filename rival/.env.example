# ---------------------------------------------------------------------------
# RIVAL environment variables
# ---------------------------------------------------------------------------

# Runtime connection used by the web app. MUST be the restricted `rival_app`
# role (created by `npm run db:migrate`) — never the database owner — so that
# row-level security is enforced. Use the POOLED connection string on Neon.
DATABASE_URL="postgresql://rival_app:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# Owner connection used ONLY by `npm run db:migrate` (direct, not pooled).
MIGRATION_DATABASE_URL="postgresql://neondb_owner:<password>@<host>.<region>.aws.neon.tech/neondb?sslmode=require"

# Password the migration script assigns to the rival_app role.
# Generate with: openssl rand -hex 24
RIVAL_APP_DB_PASSWORD=""

# Protects /api/cron/advance (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=""
