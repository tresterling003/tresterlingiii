generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Deliberately has NO relation field back to Claim. Prisma's generated
// GiftGetPayload / findMany types therefore have no `claims` accessor to
// accidentally `include` or `select` from admin-side code.
model Gift {
  id        String   @id @default(cuid())
  title     String
  link      String
  imageUrl  String?
  price     String?
  notes     String?
  occasion  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Claim {
  id          String   @id @default(cuid())
  giftId      String   @unique
  claimerName String
  claimedAt   DateTime @default(now())
}

// Singleton row, id is always 1.
model ThemeSettings {
  id                 Int      @id @default(1)
  primaryColor       String   @default("#6d28d9")
  accentColor        String   @default("#f59e0b")
  backgroundColor    String   @default("#0f0f13")
  textColor          String   @default("#f5f5f7")
  backgroundImageUrl String?
  animationPack      String   @default("none")
  updatedAt          DateTime @updatedAt
}
